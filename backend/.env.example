DATABASE_URL=postgresql://user:password@localhost:5432/thrifted
SECRET_KEY=change-me-to-a-random-secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mailtrap SMTP settings (or any SMTP provider)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
FRONTEND_URL=http://localhost:3000

ANTHROPIC_API_KEY=

# Voyage AI - embeddings per 5.3 (visual search), docs.voyageai.com
VOYAGE_API_KEY=

# Stripe (test mode) - get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Local dev: `stripe listen --forward-to localhost:8000/api/webhooks/stripe`
# prints the whsec_... value to put here. In production, use the signing
# secret shown on the webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# SMS - verifikim numri telefoni (app/core/sms.py). Ende PA ofrues te
# zgjedhur (shih "Vendime te Hapura" te docs/faza/faza-2-frontend-integrimi.md) -
# derisa te plotesohen keto dy, kodi OTP thjesht logohet ne konsolen e
# backend-it (mjafton per zhvillim/teste lokale).
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
